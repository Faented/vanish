#!/usr/bin/env bash
# pre-commit: барьер утечек.
#   FAIL — секретоподобные конструкции (ключи/токены API) в индексе,
#          файлы .env / *.key / *.pem, полный кадр > 5 МиБ, файлы из игнора.
#   WARN — generic-пары вида password:/token: (не блокируют; осознайте fixture).
# Список исключений — сами файлы с паттернами (иначе самопоймает).

set -euo pipefail

EXCLUDE=(
  '.githooks/'
  'scripts/security-audit.sh'
  '.gitignore'
  '.gitattributes'
)

is_excluded() {
  local f="$1"
  for e in "${EXCLUDE[@]}"; do
    case "$f" in "$e"*) return 0 ;; esac
  done
  return 1
}

SECRET_RE='(-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghu_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|ghr_[A-Za-z0-9]{36}|xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|sk-[A-Za-z0-9]{32,})'

files="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$files" ] && exit 0

rc=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  is_excluded "$f" && continue

  # 1) секретоподобные строки — жёсткий запрет
  if grep -qE "$SECRET_RE" "$f"; then
    echo "[pre-commit] ЗАПРЕТ: похоже на секрет (ключ/токен) в '$f':" >&2
    grep -nE "$SECRET_RE" "$f" | head -3 | sed 's/^/[pre-commit]   /' >&2
    rc=1
  fi

  # 2) забывчивые .env / ключевые файлы
  case "$f" in
    .env|.env.*|*.pem|*.key|*.pfx|*.p12|id_rsa*|id_ed25519*|id_ecdsa*|id_dsa*)
      echo "[pre-commit] ЗАПРЕТ: файл '$f' относится к классу секретов (добавить можно только осознанно: git commit --no-verify)" >&2
      rc=1 ;;
  esac

  # 3) крупный кадр
  size=$(stat -c %s "$f" 2>/dev/null || echo 0)
  if [ "$size" -gt 5242880 ]; then
    echo "[pre-commit] ЗАПРЕТ: '$f' = $size байт (> 5 МиБ). Бинарники/дампы в git не нужны; при осознанной необходимости — git commit --no-verify" >&2
    rc=1
  fi

  # 4) generic-подозрения (только предупреждение)
  if grep -qE "([Pp]assword|[Ss]ecret|[Tt]oken)[[:space:]]*[:=][[:space:]]*[\"'][^\"']{8,}[\"']" "$f"; then
    echo "[pre-commit] ВНИМАНИЕ: в '$f' похоже на хардкод пароля/токена — убедитесь, что это безвредная фикстура" >&2
  fi
done <<< "$files"

exit $rc
